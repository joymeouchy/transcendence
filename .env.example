# Copy this file to .env and fill in your own values: cp .env.example .env
# Never commit .env.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase project (avatar storage, public "avatars" bucket)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Long random strings, e.g. generated with: openssl rand -hex 32
JWT_SECRET=""
SESSION_SECRET=""

# Google OAuth 2.0 client
# Authorized redirect URI: https://localhost:8443/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail address + app password used to send password-reset emails
EMAIL_USER=""
EMAIL_PASS=""

# Public URL of this backend, used to build absolute links (e.g. avatar URLs)
# returned to clients. Must be set to the real public host when deployed,
# otherwise uploaded avatars won't load for other users.
BACKEND_URL="https://localhost:8443/api"

# Origin the frontend is served from; the backend only accepts API/socket
# requests (CORS) from this address. Change together with BACKEND_URL when hosting.
FRONTEND_URL="https://localhost:8443"
