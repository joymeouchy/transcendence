# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://<username>:<password>@<host>:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://<username>:<password>@<host>:5432/postgres"
JWT_SECRET="replace-with-strong-jwt-secret"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
SESSION_SECRET="replace-with-strong-session-secret"

EMAIL_USER="replace-with-email-user"
EMAIL_PASS="replace-with-email-pass"

# Public URL of this backend, used to build absolute links (e.g. avatar URLs)
# returned to clients. Must be set to the real public host when deployed,
# otherwise uploaded avatars won't load for other users.
BACKEND_URL="http://localhost:3001"
